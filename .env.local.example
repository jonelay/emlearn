# emlearn MCU Development Environment
# =====================================
# Source this file before running MCU benchmarks:
#   source .env.local
#
# This file auto-detects common installation paths but respects
# existing environment variables. Set variables before sourcing
# to override auto-detection.

# Zephyr kernel location
# Default: ~/zephyrproject/zephyr or sibling directory
# Install: https://docs.zephyrproject.org/latest/develop/getting_started/
if [ -z "$ZEPHYR_BASE" ]; then
    if [ -d "$HOME/zephyrproject/zephyr" ]; then
        export ZEPHYR_BASE="$HOME/zephyrproject/zephyr"
    elif [ -d "$(dirname "$PWD")/zephyrproject/zephyr" ]; then
        # Sibling directory (workspace layout)
        export ZEPHYR_BASE="$(dirname "$PWD")/zephyrproject/zephyr"
    fi
fi

# Zephyr SDK toolchain location
# Default: ~/zephyr-sdk-*/ or sibling directory
# Download: https://github.com/zephyrproject-rtos/sdk-ng/releases
if [ -z "$ZEPHYR_SDK_INSTALL_DIR" ]; then
    # Try home directory first
    _sdk_path=$(ls -d "$HOME"/zephyr-sdk-*/ 2>/dev/null | sort -V | tail -1)
    if [ -z "$_sdk_path" ]; then
        # Try sibling directory (workspace layout)
        _sdk_path=$(ls -d "$(dirname "$PWD")"/zephyr-sdk-*/ 2>/dev/null | sort -V | tail -1)
    fi
    if [ -n "$_sdk_path" ]; then
        export ZEPHYR_SDK_INSTALL_DIR="$_sdk_path"
    fi
    unset _sdk_path
fi

# Renode emulator (optional, for Renode benchmarks)
# Default: system PATH, ~/renode_*, or sibling directory
# Download: https://github.com/renode/renode/releases
if [ -z "$RENODE_PATH" ]; then
    # Check if renode is in PATH
    if command -v renode >/dev/null 2>&1; then
        export RENODE_PATH="$(command -v renode)"
    else
        # Try home directory
        _renode_path=$(ls -d "$HOME"/renode_*/renode 2>/dev/null | sort -V | tail -1)
        if [ -z "$_renode_path" ]; then
            # Try sibling directory (workspace layout)
            _renode_path=$(ls -d "$(dirname "$PWD")"/renode_*/renode 2>/dev/null | sort -V | tail -1)
        fi
        if [ -n "$_renode_path" ]; then
            export RENODE_PATH="$_renode_path"
        fi
        unset _renode_path
    fi
fi

# Add project venv to PATH (for west, pytest, etc.)
if [ -d "$PWD/.venv/bin" ]; then
    export PATH="$PWD/.venv/bin:$PATH"
fi

# Verify configuration
_missing=""
[ -z "$ZEPHYR_BASE" ] && _missing="$_missing ZEPHYR_BASE"
[ -z "$ZEPHYR_SDK_INSTALL_DIR" ] && _missing="$_missing ZEPHYR_SDK_INSTALL_DIR"

if [ -n "$_missing" ]; then
    echo "Warning: Could not auto-detect:$_missing"
    echo "Set these variables manually or install to default locations."
else
    echo "Environment configured:"
    echo "  ZEPHYR_BASE=$ZEPHYR_BASE"
    echo "  ZEPHYR_SDK_INSTALL_DIR=$ZEPHYR_SDK_INSTALL_DIR"
    [ -n "$RENODE_PATH" ] && echo "  RENODE_PATH=$RENODE_PATH"
fi
unset _missing
